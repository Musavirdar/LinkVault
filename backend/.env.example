# ==============================================================================
# LinkVault Environment Configuration Template
# ==============================================================================

# Reverse Proxy / Forwarded Headers (Required on Render and containerized reverse proxies)
ASPNETCORE_FORWARDEDHEADERS_ENABLED="true"

# Database Connection (PostgreSQL)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=linkvault;Username=linkvault;Password=YOUR_SECURE_PASSWORD;SSL Mode=Disable;Trust Server Certificate=true"

# JWT Authentication
# IMPORTANT: Must be at least 32 characters (256 bits) long. Insecure placeholders will fail startup validation.
JwtSettings__Secret="generate-a-cryptographically-random-256-bit-key-here-for-production"
JwtSettings__Issuer="LinkVaultApi"
JwtSettings__Audience="LinkVaultClient"
JwtSettings__ExpiryMinutes="60"
JwtSettings__RefreshTokenExpiryDays="7"

# CORS
Cors__AllowedOrigins__0="http://localhost:5173"
Cors__AllowedOrigins__1="http://localhost:3000"

# SSO OAuth Credentials (Optional)
SsoSettings__Google__ClientId=""
SsoSettings__Google__ClientSecret=""
SsoSettings__GitHub__ClientId=""
SsoSettings__GitHub__ClientSecret=""
SsoSettings__LinkedIn__ClientId=""
SsoSettings__LinkedIn__ClientSecret=""

# File Storage
FileStorage__MaxFileSizeBytes="10485760"
FileStorage__UploadsPath="./uploads"

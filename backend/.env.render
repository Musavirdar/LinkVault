# ==========================================
# RENDER DEPLOYMENT ENVIRONMENT VARIABLES
# ==========================================
# You can copy and paste these keys into the "Environment" tab of your Render Web Service.
# Render allows bulk importing by pasting a .env file format like this.

# 1. DATABASE CONNECTION
# Replace with your actual production PostgreSQL connection string (e.g., from Supabase or Render Postgres)
ConnectionStrings__DefaultConnection="Host=dpg-d6p8fb9j16oc738ukdkg-a.oregon-postgres.render.com;Port=5432;Database=linkvault_db_19f1;Username=linkvault_db_19f1_user;Password=QHMroGZ1oxMou8G7x8qwgwds24Uk7kIg;SslMode=Require;"

# 2. JWT AUTHENTICATION
# Generate a new, secure random string (at least 32 characters) for production
JwtSettings__Secret="replace_this_with_a_very_long_secure_random_string_for_production"
JwtSettings__Issuer="LinkVaultApi"
JwtSettings__Audience="LinkVaultClient"
# Optional: Adjust token lifespans
JwtSettings__ExpiryMinutes="60"
JwtSettings__RefreshTokenExpiryDays="7"

# 3. CORS CONFIGURATION
# IMPORTANT: Put your actual Vercel frontend URL here so your frontend can communicate with the backend
Cors__AllowedOrigins__0="https://linkvault-your-project-url.vercel.app"

# 4. SINGLE SIGN-ON (SSO) SETTINGS (Optional)
# If you are using Google or GitHub login, provide the production OAuth credentials here
SsoSettings__Google__ClientId=""
SsoSettings__Google__ClientSecret=""
SsoSettings__GitHub__ClientId=""
SsoSettings__GitHub__ClientSecret=""
